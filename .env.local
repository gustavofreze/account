# Local defaults for the proof of concept. Committed on purpose, so a clone runs with no setup step.
# Every value here is local-only and reaches nothing outside this machine. Never put a real credential in it.

# Application
DEBUG=false
SOURCE=https://github.com/gustavofreze/account
APP_NAME=account

# Database
DATABASE_HOST=account-adm
DATABASE_PORT=3306
DATABASE_NAME=account_adm
DATABASE_USER=root
DATABASE_PASSWORD=root

# Migrations
FLYWAY_USER=root
FLYWAY_TABLE=schema_history
FLYWAY_SCHEMAS=account_adm
FLYWAY_PASSWORD=root
FLYWAY_LOCATIONS=filesystem:/flyway/sql
FLYWAY_CLEAN_DISABLED=false
FLYWAY_VALIDATE_MIGRATION_NAMING=true
FLYWAY_URL=jdbc:mysql://account-adm:3306/account_adm?allowPublicKeyRetrieval=true&useUnicode=yes&characterEncoding=UTF-8
